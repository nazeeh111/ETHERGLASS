include LICENSE README.md CITATION.cff CONTRIBUTING.md ARTIFACTS.json .gitignore .gitattributes
recursive-include .github *.yml
recursive-include docs *.md
recursive-include research *.py *.json *.csv *.txt *.md *.png *.svg
recursive-include models *.pt *.json *.csv *.npz
recursive-include examples *.sigmf-data *.sigmf-meta *.json *.md *.npz LICENSE
recursive-include scripts *.py *.cjs
recursive-include tests *.py
recursive-include assets *.png *.svg *.json *.mp4 *.jpg *.md *.html *.js *.css *.wav *.py *.cjs *.txt
prune assets/launch/composition/snapshots
global-exclude *.pyc
global-exclude __pycache__
